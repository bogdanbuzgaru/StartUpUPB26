# Copy this file to `.env.local` and fill in the values.

# Supabase (public, safe for the browser – protected by Row Level Security, see supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini – SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
